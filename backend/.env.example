# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ragchat

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional, leave empty for local Qdrant

# Redis (for future caching/sessions)
REDIS_URL=redis://localhost:6379

# App Configuration
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
CORS_ORIGINS=["http://localhost:3000"]

# RAG Configuration - Chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
TOKENIZER=cl100k_base

# RAG Configuration - Embedding
RAG_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG Configuration - Reranking
ENABLE_RERANKING=true
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-large-v1
INITIAL_RETRIEVAL_K=40
RERANK_TOP_K=15

# RAG Configuration - Deduplication
ENABLE_MMR=true
MMR_LAMBDA=0.7
FINAL_RETRIEVAL_K=8

# RAG Configuration - Optional API-based rerankers
# COHERE_API_KEY=your-cohere-api-key-here

# RAG Configuration - Hybrid Search (optional)
ENABLE_HYBRID_SEARCH=false
BM25_BACKEND=postgresql
HYBRID_SEARCH_SEMANTIC_WEIGHT=0.5
HYBRID_SEARCH_KEYWORD_WEIGHT=0.5
